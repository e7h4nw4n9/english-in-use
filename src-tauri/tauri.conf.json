{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "english-in-use",
  "version": "0.1.0",
  "identifier": "com.ethan.english-in-use",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "english-in-use",
        "width": 800,
        "height": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: eiuasset: https:; script-src 'self' 'unsafe-inline' 'unsafe-eval' asset: eiuasset: blob: https:; style-src 'self' 'unsafe-inline' asset: eiuasset: https:; img-src 'self' asset: eiuasset: blob: data: https:; connect-src 'self' asset: eiuasset: https:; frame-src 'self' asset: eiuasset: blob: https:;",
      "assetProtocol": {
        "enable": true,
        "scope": ["**", "$APPCACHE/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "iOS": {
      "developmentTeam": "7F55A5M7G5"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
