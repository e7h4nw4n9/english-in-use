{
  "name": "english-in-use",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck:frontend && vite build",
    "preview": "vite preview",
    "typecheck": "pnpm typecheck:frontend && pnpm typecheck:worker",
    "typecheck:frontend": "vue-tsc --noEmit",
    "typecheck:worker": "tsc --noEmit -p worker/tsconfig.json",
    "test:run": "vitest run",
    "format:check": "prettier --check \"src/**/*.{ts,vue,json}\" \"worker/**/*.{ts,json,jsonc}\" \"*.{json,ts,js,mjs,cjs,yaml,yml}\" \".github/**/*.{yaml,yml}\"",
    "check": "pnpm format:check && pnpm typecheck && pnpm test:run",
    "tauri": "tauri",
    "tauri:icon": "tauri icon src-tauri/icons/icon-manifest.json",
    "tauri:build:release": "VITE_ENABLE_DEBUG_FEATURES=false pnpm tauri build",
    "tauri:build:debug-tools": "VITE_ENABLE_DEBUG_FEATURES=true pnpm tauri build",
    "tauri:ios:init": "tauri ios init",
    "tauri:ios:dev": "tauri ios dev",
    "tauri:ios:build": "tauri ios build",
    "tauri:ios:build:release": "node tools/ios/ensure-clang-runtime-cache.mjs && VITE_ENABLE_DEBUG_FEATURES=false pnpm tauri ios build",
    "tauri:ios:build:debug-tools": "VITE_ENABLE_DEBUG_FEATURES=true pnpm tauri ios build",
    "tauri:ios:run:release": "bash tools/ios/run-release-on-ipad.sh",
    "test": "vitest",
    "worker:dev": "pnpm --dir worker dev",
    "worker:deploy": "pnpm --dir worker deploy",
    "prepare": "husky"
  },
  "dependencies": {
    "@ant-design/icons-vue": "6.1.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-fs": "~2.4.5",
    "@tauri-apps/plugin-log": "^2",
    "@tauri-apps/plugin-window-state": "^2.4.1",
    "ant-design-vue": "4.0.0-rc.6",
    "pinia": "^3.0.4",
    "tailwindcss-animate": "^1.0.7",
    "vue": "^3.5.13",
    "vue-i18n": "^11.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^25.2.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^4.0.18",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.24",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "lint-staged": "^16.2.7",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "3",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^4.0.18",
    "vue-tsc": "^2.1.10"
  }
}
